# Copy to .env and adjust. All values shown are the defaults.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text

QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=documents_v2
MIN_SCORE=0.58

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mychatapp

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=*

# RAGAS evaluation (evals/run_ragas.py). Defaults to CHAT_MODEL; a larger judge gives
# more trustworthy scores.
EVAL_MODEL=llama3.2:1b
EVAL_EMBED_MODEL=nomic-embed-text
