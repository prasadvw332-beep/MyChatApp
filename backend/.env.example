# Copy to .env and adjust. All values shown are the defaults.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text

QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=documents_v2
MIN_SCORE=0.58

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mychatapp

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents

# Comma-separated list of allowed frontend origins (login cookies need exact origins, not *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_DAYS=7
COOKIE_SECURE=false

# RAGAS evaluation (evals/run_ragas.py). Defaults to CHAT_MODEL; a larger judge gives
# more trustworthy scores.
EVAL_MODEL=llama3.2:1b
EVAL_EMBED_MODEL=nomic-embed-text

# Batch ingestion (python -m app.worker / python -m app.ingest_cli)
INGEST_BATCH_SIZE=100
INGEST_MAX_ATTEMPTS=3
INGEST_LEASE_SECONDS=600
EMBED_BATCH_SIZE=64
