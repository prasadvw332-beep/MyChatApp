# Copy to .env and adjust. All values shown are the defaults.

# development | production. In production the backend refuses to start with the dev passwords
# below, a missing/short JWT_SECRET, or COOKIE_SECURE=false. Production logs are JSON lines.
APP_ENV=development
LOG_LEVEL=INFO

# Observability (deploy/README.md, "Observability"). Prometheus scrapes METRICS_PORT (0 = off); it is
# separate from the API port so nginx never exposes it. Tracing is off while the endpoint is empty.
METRICS_PORT=9100
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

# Agent mode (/agent/chat). Needs a tool-calling model; qwen2.5:7b or llama3.1:8b work far better
# than llama3.2:1b. MCP_SERVERS_FILE optionally adds external MCP servers (see mcp_servers.example.json).
AGENT_MODEL=llama3.2:1b
AGENT_MAX_STEPS=4
MCP_SERVERS_FILE=

# Token cost estimate, USD per 1 million tokens (Grafana "Tokens & cost"). Ollama is free, so the
# defaults are a small hosted model's list price; set 0 and 0 to track tokens only.
LLM_PRICE_INPUT_PER_MTOK=0.15
LLM_PRICE_OUTPUT_PER_MTOK=0.60

# Guardrails (docs/guardrails.md). enforce | monitor (count and audit only) | off.
# GUARD_MODEL turns on content safety, e.g. llama-guard3:1b (ollama pull it first); empty = off.
GUARDRAILS_MODE=enforce
GUARD_MODEL=
GUARD_BLOCK_CATEGORIES=S1,S2,S3,S4,S9,S10,S11,S12

QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=documents_v2
MIN_SCORE=0.58
QDRANT_TIMEOUT=30

# Caching (docs/caching.md). Embeddings: an LRU per process, then PostgreSQL (table embedding_cache).
# Answers: a chat's first question this similar to one already answered gets the stored answer, without
# retrieval or the model; emptied by every document upload/delete. Collection default: <QDRANT_COLLECTION>_answers
EMBED_CACHE=true
EMBED_CACHE_MEMORY_ITEMS=10000
SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_COLLECTION=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mychatapp

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents

# Comma-separated list of allowed frontend origins (login cookies need exact origins, not *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits per user (registration: per IP), shared by all replicas through PostgreSQL.
# <count>/<second|minute|hour|day>; empty = no limit. Over the limit: 429 with Retry-After.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=60/hour
RATE_LIMIT_EVAL=5/hour
RATE_LIMIT_REGISTER=5/hour

# Login. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_DAYS=7
COOKIE_SECURE=false

# RAGAS evaluation (evals/run_ragas.py). Defaults to CHAT_MODEL; a larger judge gives
# more trustworthy scores.
EVAL_MODEL=llama3.2:1b
EVAL_EMBED_MODEL=nomic-embed-text

# Batch ingestion (python -m app.ingestion.worker / python -m app.ingestion.cli)
INGEST_BATCH_SIZE=100
INGEST_MAX_ATTEMPTS=3
INGEST_LEASE_SECONDS=600
EMBED_BATCH_SIZE=64
