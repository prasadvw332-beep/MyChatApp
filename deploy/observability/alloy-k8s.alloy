// Grafana Alloy for Kubernetes: reads the logs of every pod in the mychatapp namespace and sends them to Loki.
// Same pipeline as alloy-compose.alloy; only discovery and the labels differ.
//
// Logs are read through the Kubernetes API (what `kubectl logs` does), not from the node's disk, so one
// Alloy pod covers every node and needs no hostPath. Its permissions: the Role in k8s.yaml
// (list pods, read their logs, in this namespace only). On a large cluster you would run it as a
// DaemonSet reading /var/log/pods instead.

discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["mychatapp"]
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  // service = the pod's app label (backend, worker, postgres...), the same values as in compose
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.app.receiver]
}

// Our own JSON lines (backend, workers): the level becomes a label, the ids become structured metadata.
loki.process "app" {
  stage.match {
    selector = "{service=~\"backend|worker\"}"

    stage.json {
      expressions = {
        level      = "level",
        request_id = "request_id",
        user_id    = "user_id",
        trace_id   = "trace_id",
      }
    }
    stage.labels {
      values = { level = "" }
    }
    stage.structured_metadata {
      values = {
        request_id = "",
        user_id    = "",
        trace_id   = "",
      }
    }
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
